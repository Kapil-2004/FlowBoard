server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Required for dynamic proxy_pass targets using variables
    # 169.254.169.253 is Render's internal DNS server
    resolver 169.254.169.253 8.8.8.8 valid=30s;

    # Angular routing support
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to microservices
    # Auth Service handles both /api/auth and /api/admin
    location /api/auth/ {
        proxy_pass http://${AUTH_SERVICE_URL}:10000/api/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/admin/ {
        proxy_pass http://${AUTH_SERVICE_URL}:10000/api/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/workspaces/ {
        proxy_pass http://${WORKSPACE_SERVICE_URL}:10000/api/workspaces/;
        proxy_set_header Host $host;
    }

    location /api/boards/ {
        proxy_pass http://${BOARD_SERVICE_URL}:10000/api/boards/;
        proxy_set_header Host $host;
    }

    location /api/lists/ {
        proxy_pass http://${LIST_SERVICE_URL}:10000/api/lists/;
        proxy_set_header Host $host;
    }

    location /api/cards/ {
        proxy_pass http://${CARD_SERVICE_URL}:10000/api/cards/;
        proxy_set_header Host $host;
    }

    location /api/comments/ {
        proxy_pass http://${COMMENT_SERVICE_URL}:10000/api/comments/;
        proxy_set_header Host $host;
    }

    location /api/attachments/ {
        proxy_pass http://${COMMENT_SERVICE_URL}:10000/api/attachments/;
        proxy_set_header Host $host;
    }

    location /api/labels/ {
        proxy_pass http://${LABEL_SERVICE_URL}:10000/api/label/;
        proxy_set_header Host $host;
    }

    location /api/checklist/ {
        proxy_pass http://${LABEL_SERVICE_URL}:10000/api/checklist/;
        proxy_set_header Host $host;
    }

    location /api/notifications/ {
        proxy_pass http://${NOTIFICATION_SERVICE_URL}:10000/api/notifications/;
        proxy_set_header Host $host;
        
        # WebSockets for SignalR
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
