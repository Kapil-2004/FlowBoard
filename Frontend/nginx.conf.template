server {
    listen ${PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # --- API Gateway Proxy ---
    # Everything under /api is routed to the central Gateway
    location /api/ {
        proxy_pass http://flowboard-gateway:10000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SignalR Hubs for real-time notifications
    location /hubs/ {
        proxy_pass http://flowboard-gateway:10000/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Angular SPA routing support
    location / {
        try_files $uri $uri/ /index.html;
    }
}
