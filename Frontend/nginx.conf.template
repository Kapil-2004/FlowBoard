server {
    listen ${PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Use Google DNS to resolve public .onrender.com URLs
    resolver 8.8.8.8 8.8.4.4 valid=30s;

    # Angular routing support
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy settings for public routing
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Auth Service
    location /api/auth/ {
        set $auth_upstream ${AUTH_SERVICE_URL};
        proxy_pass https://$auth_upstream;
        proxy_set_header Host $auth_upstream;
    }

    location /api/admin/ {
        set $auth_upstream ${AUTH_SERVICE_URL};
        proxy_pass https://$auth_upstream;
        proxy_set_header Host $auth_upstream;
    }

    # Workspace Service
    location /api/workspaces/ {
        set $workspace_upstream ${WORKSPACE_SERVICE_URL};
        proxy_pass https://$workspace_upstream;
        proxy_set_header Host $workspace_upstream;
    }

    # Board Service
    location /api/boards/ {
        set $board_upstream ${BOARD_SERVICE_URL};
        proxy_pass https://$board_upstream;
        proxy_set_header Host $board_upstream;
    }

    # List Service
    location /api/lists/ {
        set $list_upstream ${LIST_SERVICE_URL};
        proxy_pass https://$list_upstream;
        proxy_set_header Host $list_upstream;
    }

    # Card Service
    location /api/cards/ {
        set $card_upstream ${CARD_SERVICE_URL};
        proxy_pass https://$card_upstream;
        proxy_set_header Host $card_upstream;
    }

    # Comment/Attachment Service
    location /api/comments/ {
        set $comment_upstream ${COMMENT_SERVICE_URL};
        proxy_pass https://$comment_upstream;
        proxy_set_header Host $comment_upstream;
    }

    location /api/attachments/ {
        set $comment_upstream ${COMMENT_SERVICE_URL};
        proxy_pass https://$comment_upstream;
        proxy_set_header Host $comment_upstream;
    }

    # Label Service
    location /api/labels/ {
        set $label_upstream ${LABEL_SERVICE_URL};
        proxy_pass https://$label_upstream;
        proxy_set_header Host $label_upstream;
    }

    location /api/checklist/ {
        set $label_upstream ${LABEL_SERVICE_URL};
        proxy_pass https://$label_upstream;
        proxy_set_header Host $label_upstream;
    }

    # Notification Service
    location /api/notifications/ {
        set $notification_upstream ${NOTIFICATION_SERVICE_URL};
        proxy_pass https://$notification_upstream;
        proxy_set_header Host $notification_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
