server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Required for dynamic proxy_pass targets using variables
    # Use Docker/Render's internal DNS and disable IPv6 to prevent resolution delays
    resolver 127.0.0.11 169.254.169.253 8.8.8.8 valid=30s ipv6=off;

    # Angular routing support
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to microservices
    # Auth Service handles both /api/auth and /api/admin
    location /api/auth/ {
        set $auth_upstream ${AUTH_SERVICE_URL};
        proxy_pass http://$auth_upstream:10000;
        proxy_set_header Host $auth_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/admin/ {
        set $auth_upstream ${AUTH_SERVICE_URL};
        proxy_pass http://$auth_upstream:10000;
        proxy_set_header Host $auth_upstream;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/workspaces/ {
        set $workspace_upstream ${WORKSPACE_SERVICE_URL};
        proxy_pass http://$workspace_upstream:10000;
        proxy_set_header Host $workspace_upstream;
    }

    location /api/boards/ {
        set $board_upstream ${BOARD_SERVICE_URL};
        proxy_pass http://$board_upstream:10000;
        proxy_set_header Host $board_upstream;
    }

    location /api/lists/ {
        set $list_upstream ${LIST_SERVICE_URL};
        proxy_pass http://$list_upstream:10000;
        proxy_set_header Host $list_upstream;
    }

    location /api/cards/ {
        set $card_upstream ${CARD_SERVICE_URL};
        proxy_pass http://$card_upstream:10000;
        proxy_set_header Host $card_upstream;
    }

    location /api/comments/ {
        set $comment_upstream ${COMMENT_SERVICE_URL};
        proxy_pass http://$comment_upstream:10000;
        proxy_set_header Host $comment_upstream;
    }

    location /api/attachments/ {
        set $comment_upstream ${COMMENT_SERVICE_URL};
        proxy_pass http://$comment_upstream:10000;
        proxy_set_header Host $comment_upstream;
    }

    location /api/labels/ {
        set $label_upstream ${LABEL_SERVICE_URL};
        proxy_pass http://$label_upstream:10000;
        proxy_set_header Host $label_upstream;
    }

    location /api/checklist/ {
        set $label_upstream ${LABEL_SERVICE_URL};
        proxy_pass http://$label_upstream:10000;
        proxy_set_header Host $label_upstream;
    }

    location /api/notifications/ {
        set $notification_upstream ${NOTIFICATION_SERVICE_URL};
        proxy_pass http://$notification_upstream:10000;
        proxy_set_header Host $notification_upstream;
        
        # WebSockets for SignalR
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
