server {
    listen ${PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Angular routing support
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy settings for stability
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Auth Service
    location /api/auth/ {
        proxy_pass http://${AUTH_SERVICE_URL};
    }

    location /api/admin/ {
        proxy_pass http://${AUTH_SERVICE_URL};
    }

    # Workspace Service
    location /api/workspaces/ {
        proxy_pass http://${WORKSPACE_SERVICE_URL};
    }

    # Board Service
    location /api/boards/ {
        proxy_pass http://${BOARD_SERVICE_URL};
    }

    # List Service
    location /api/lists/ {
        proxy_pass http://${LIST_SERVICE_URL};
    }

    # Card Service
    location /api/cards/ {
        proxy_pass http://${CARD_SERVICE_URL};
    }

    # Comment/Attachment Service
    location /api/comments/ {
        proxy_pass http://${COMMENT_SERVICE_URL};
    }

    location /api/attachments/ {
        proxy_pass http://${COMMENT_SERVICE_URL};
    }

    # Label Service
    location /api/labels/ {
        proxy_pass http://${LABEL_SERVICE_URL};
    }

    location /api/checklist/ {
        proxy_pass http://${LABEL_SERVICE_URL};
    }

    # Notification Service
    location /api/notifications/ {
        proxy_pass http://${NOTIFICATION_SERVICE_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
