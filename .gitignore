# .gitignore for FlowBoard Monorepo

# ── .NET / ASP.NET Core ───────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.sln.docstates
*.suo
*.db
*.db-shm
*.db-wal
TestResults/
coverage.cobertura.xml
.vs/

# ── Secrets & Config ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.Development.json
appsettings.*.json
!appsettings.json
*.pfx
*.certificate
secrets/

# ── Node / Angular ────────────────────────────────────────────────────────────
node_modules/
.angular/
dist/
tmp/
out-tsc/
bazel-out/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/
# Keep dockerfiles and compose files tracked:
# !Dockerfile
# !docker-compose.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Build artifacts ──────────────────────────────────────────────────────────
*.nupkg
*.snupkg
