# .gitignore for FlowBoard (Monorepo)

# --- Dotnet (.NET Core) ---
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.sln.docstates
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.db
*.db-shm
*.db-wal

# User-specific files
.idea/
.DS_Store

# --- Node / Angular ---
node_modules/
.angular/
dist/
tmp/
out-tsc/
bazel-out/
.npm/
